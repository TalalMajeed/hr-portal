# Postgres. In production this is Neon's pooled connection string.
DATABASE_URL=postgresql://user:password@host/du_portal?sslmode=require
# Direct (unpooled) connection, used by migrations. Optional locally.
DATABASE_URL_UNPOOLED=
# Public address of the portal, used in email links.
APP_URL=http://localhost:3000
# Optional: real email delivery through Resend.
RESEND_API_KEY=
MAIL_FROM=careers@du.edu.pk
# Optional: protects /api/cron/reminders.
CRON_SECRET=
# Optional: real Zoom meetings.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Only for npm run db:bootstrap on a fresh database.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
